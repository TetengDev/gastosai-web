# Copy to ".env" at the repo root and set your values. NEVER commit the real .env.
#
# Vite only exposes VITE_*-prefixed variables to the browser bundle, and everything in this
# repo ships to the client. Nothing secret belongs here: no AI provider key, no database
# credential, no JWT secret. Those live in the gastosai-backend repo.
#
# In production these are set as Vercel environment variables, not from a file.

# Base URL of the gastosai backend API.
VITE_API_URL=http://localhost:8080

# Free-launch mode: set to false to hide all payment/upgrade UI. Unset = billing UI visible.
# VITE_BILLING_ENABLED=false
