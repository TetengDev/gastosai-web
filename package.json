{
  "name": "gastosai-web",
  "private": true,
  "version": "0.70.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "gen:api": "openapi-typescript node_modules/@tetengdev/gastosai-api-contract/openapi.json -o src/api/generated/schema.d.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:happy": "playwright test e2e/happy --grep @happy",
    "e2e:report": "playwright show-report",
    "e2e:demo": "playwright test --config playwright.demo.config.ts",
    "e2e:showcase": "playwright test --config playwright.demo.config.ts e2e/showcase.demo.ts",
    "showcase": "./scripts/record-showcase.sh"
  },
  "dependencies": {
    "@tetengdev/gastosai-api-contract": "3.0.0",
    "axios": "^1.20.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-joyride": "^3.2.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "js-yaml": "^4.3.2",
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.8"
  }
}
